---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/layouts/Main.astro";
import { getCollection } from "astro:content";
import { SITE } from "@/config";

const statuses = (await getCollection("status")).sort((a, b) =>
  b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf()
);
---

<Layout title={`动态 | ${SITE.title}`} description={`动态 | ${SITE.desc}`}>
  <Header />
  <Main pageTitle="动态" pageDesc="记录日常、进展与随手记。">
    <div class="space-y-6">
      {statuses.map(item => (
        <article data-status-article class="rounded-2xl border border-border bg-background/80 p-5 shadow-sm transition hover:-translate-y-[2px] hover:shadow-accent/20">
          <div class="flex items-start justify-between gap-3">
            <h2 class="text-lg font-semibold text-foreground">{item.data.title}</h2>
            <time class="whitespace-nowrap text-sm text-foreground/60" datetime={item.data.pubDatetime.toISOString()}>
              {item.data.pubDatetime.toLocaleDateString("zh-CN")}
            </time>
          </div>

          <div class="prose prose-sm app-prose mt-3 text-foreground/90" set:html={item.body} />

          {item.data.images && item.data.images.length > 0 && (
            <div
              class:list={{
                "mt-4 grid gap-3": true,
                "sm:grid-cols-2": item.data.images.length >= 2,
                "lg:grid-cols-3": item.data.images.length >= 3,
              }}
            >
              {item.data.images.map((src, idx) => (
                <button
                  type="button"
                  data-status-card
                  data-src={src}
                  data-title={item.data.title}
                  data-alt={`${item.data.title} 图片 ${idx + 1}`}
                  data-meta={item.data.pubDatetime.toLocaleDateString("zh-CN")}
                  class="group relative block overflow-hidden rounded-xl border border-border bg-background/60 shadow-sm transition hover:-translate-y-[1px] hover:shadow-accent/20 focus-visible:-translate-y-[1px] focus-visible:shadow-accent/20 focus-visible:outline-none"
                >
                  <img
                    src={src}
                    alt={`${item.data.title} 图片 ${idx + 1}`}
                    loading="lazy"
                    decoding="async"
                    class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.02]"
                  />
                </button>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>

    <div
      id="status-lightbox"
      class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/75 backdrop-blur-md p-3 sm:p-6"
      aria-modal="true"
      role="dialog"
    >
      <div class="absolute inset-0" aria-hidden="true" data-lightbox-overlay></div>
      <div class="relative flex w-[min(96vw,1200px)] flex-col gap-4 rounded-3xl border border-border/80 bg-background/95 p-4 shadow-2xl shadow-accent/25 sm:p-6">
        <button
          type="button"
          data-lightbox-close
          class="self-end rounded-full border border-border/80 bg-background/80 px-3 py-1 text-sm text-foreground/80 shadow hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
          aria-label="关闭预览"
        >
          关闭
        </button>
        <div class="relative flex min-h-[50vh] items-center justify-center overflow-hidden rounded-2xl border border-border/70 bg-muted/30 p-3 sm:p-4">
          <button
            type="button"
            data-lightbox-prev
            class="group absolute left-2 top-1/2 z-10 -translate-y-1/2 rounded-full border border-border/70 bg-background/80 px-3 py-2 text-sm text-foreground shadow-lg transition hover:-translate-y-1/2 hover:-translate-x-0.5 hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
            aria-label="上一张"
          >
            ‹
          </button>
          <img
            data-lightbox-img
            src=""
            alt=""
            class="mx-auto max-h-[80vh] max-w-[90vw] object-contain"
            loading="lazy"
            decoding="async"
          />
          <button
            type="button"
            data-lightbox-next
            class="group absolute right-2 top-1/2 z-10 -translate-y-1/2 rounded-full border border-border/70 bg-background/80 px-3 py-2 text-sm text-foreground shadow-lg transition hover:-translate-y-1/2 hover:translate-x-0.5 hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
            aria-label="下一张"
          >
            ›
          </button>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 text-sm text-foreground/80">
          <div>
            <div class="text-lg font-semibold text-foreground" data-lightbox-title></div>
            <div class="mt-1 flex flex-wrap gap-2" data-lightbox-meta></div>
          </div>
        </div>
      </div>
    </div>
  </Main>
  <Footer />
</Layout>

<script>
  const setupStatusLightbox = () => {
    const cards = Array.from(
      document.querySelectorAll('[data-status-card]')
    ) as HTMLElement[];
    const lightbox = document.querySelector('#status-lightbox') as HTMLElement | null;
    if (!cards.length || !lightbox || lightbox.dataset.bound === 'true') return;

    const lightboxImg = lightbox.querySelector('[data-lightbox-img]') as HTMLImageElement | null;
    const lightboxTitle = lightbox.querySelector('[data-lightbox-title]') as HTMLElement | null;
    const lightboxMeta = lightbox.querySelector('[data-lightbox-meta]') as HTMLElement | null;
    const closeBtn = lightbox.querySelector('[data-lightbox-close]') as HTMLButtonElement | null;
    const prevBtn = lightbox.querySelector('[data-lightbox-prev]') as HTMLButtonElement | null;
    const nextBtn = lightbox.querySelector('[data-lightbox-next]') as HTMLButtonElement | null;

    let currentGroup: HTMLElement[] = [];
    let currentIndex = 0;
    lightbox.dataset.bound = 'true';

    const updateLightbox = (index: number) => {
      if (!lightboxImg || !lightboxTitle || !lightboxMeta) return;
      const card = currentGroup[index];
      if (!card) return;
      const { src, title, alt, meta } = card.dataset;
      lightboxImg.src = src || '';
      lightboxImg.alt = alt || title || '';
      lightboxTitle.textContent = title || '';
      lightboxMeta.innerHTML = meta
        ? `<span class="rounded-full border border-border/70 px-2 py-1">${meta}</span>`
        : '';
    };

    const close = () => {
      lightbox.classList.add('hidden');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    const open = (card: HTMLElement) => {
      const article = card.closest('[data-status-article]');
      currentGroup = article
        ? (Array.from(article.querySelectorAll('[data-status-card]')) as HTMLElement[])
        : [card];
      currentIndex = Math.max(0, currentGroup.indexOf(card));
      updateLightbox(currentIndex);

      lightbox.classList.remove('hidden');
      lightbox.removeAttribute('aria-hidden');
      document.body.style.overflow = 'hidden';
    };

    const step = (delta: number) => {
      if (lightbox.classList.contains('hidden') || !currentGroup.length) return;
      currentIndex = (currentIndex + delta + currentGroup.length) % currentGroup.length;
      updateLightbox(currentIndex);
    };

    cards.forEach(card => {
      const handler = () => open(card);
      card.addEventListener('click', handler);
      card.addEventListener('keydown', event => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          handler();
        }
      });
    });

    closeBtn?.addEventListener('click', close);
    prevBtn?.addEventListener('click', () => step(-1));
    nextBtn?.addEventListener('click', () => step(1));
    lightbox.addEventListener('click', event => {
      const target = event.target as HTMLElement;
      if (target === lightbox || target.dataset.lightboxOverlay !== undefined) {
        close();
      }
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') close();
      if (event.key === 'ArrowLeft') step(-1);
      if (event.key === 'ArrowRight') step(1);
    });
  };

  document.addEventListener('astro:page-load', setupStatusLightbox);
  document.addEventListener('astro:after-swap', setupStatusLightbox);
  setupStatusLightbox();
</script>
