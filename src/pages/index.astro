---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import photos from "@/data/photos";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const totalPosts = sortedPosts.length;
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section
      id="hero"
      class:list={["pt-8 pb-8", "border-b border-border"]}
    >
      <div class="grid gap-6 sm:grid-cols-[1.8fr_1fr] sm:items-center">
        <div>
          <h1 class="my-2 inline-block text-4xl font-bold sm:my-4 sm:text-5xl">
            你好，欢迎光临
          </h1>
          <p class="mt-2 text-foreground/80">这是 yaho 的个人网站，记录项目、随笔与照片。</p>
          <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-foreground/70">
            <span class="rounded-full border border-border/80 bg-background/70 px-3 py-1">文章 {totalPosts}</span>
            <span class="rounded-full border border-border/80 bg-background/70 px-3 py-1">精选 {featuredPosts.length}</span>
            <a
              target="_blank"
              href="/rss.xml"
              class="inline-flex items-center gap-1 rounded-full border border-border/80 bg-background/70 px-3 py-1 text-foreground/80 transition hover:text-accent"
              aria-label="订阅 RSS"
              title="订阅 RSS"
            >
              <IconRss width={18} height={18} class="stroke-accent stroke-2 rtl:-rotate-90" />
              RSS 订阅
            </a>
          </div>
          {
            SOCIALS.length > 0 && (
              <div class="mt-4 flex max-sm:flex-col sm:items-center">
                <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">社交链接：</div>
                <Socials />
              </div>
            )
          }
        </div>
        <div class="rounded-2xl border border-border bg-background/60 p-3 shadow-sm">
          <div class="flex items-center justify-between text-sm text-foreground/70">
            <span>最新照片</span>
            <LinkButton href="/photos" class="text-xs">查看全部 →</LinkButton>
          </div>
          <div class="mt-3 grid grid-cols-3 gap-2">
            {photos.slice(0, 3).map(photo => (
              <img
                src={photo.src}
                alt={photo.alt}
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full rounded-xl border border-border object-cover"
              />
            ))}
          </div>
        </div>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">精选推荐</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">最新文章</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        所有文章
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
