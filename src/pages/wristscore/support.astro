---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import WristScoreLocaleSwitcher from "@/components/wristscore/WristScoreLocaleSwitcher.astro";
import { WRISTSCORE_SUPPORT_CONTENT } from "@/data/wristscoreI18n";

const supportContent = WRISTSCORE_SUPPORT_CONTENT["zh-CN"];
const supportMessages = {
  "zh-CN": WRISTSCORE_SUPPORT_CONTENT["zh-CN"],
  en: WRISTSCORE_SUPPORT_CONTENT.en,
};
---

<Layout
  title={supportContent.meta.title}
  description={supportContent.meta.description}
>
  <div data-wristscore-page>
    <Header />
    <Breadcrumb />

    <main id="main-content" class="app-layout pb-20">
      <WristScoreLocaleSwitcher
        messages={supportMessages}
        showSelector={false}
      />

      <section
        class="relative mt-6 overflow-hidden rounded-[2rem] border border-border bg-gradient-to-br from-background via-background to-accent/[0.08] px-6 py-10 shadow-sm sm:px-10 sm:py-14"
      >
        <div
          class="absolute -top-16 right-[-2rem] h-48 w-48 rounded-full bg-accent/10 blur-3xl"
        >
        </div>
        <div
          class="absolute bottom-[-5rem] left-[-2rem] h-44 w-44 rounded-full bg-foreground/5 blur-3xl"
        >
        </div>

        <div
          class="relative grid gap-10 lg:grid-cols-[1.3fr_0.75fr] lg:items-center"
        >
          <div class="max-w-3xl">
            <p
              class="text-sm font-semibold tracking-[0.18em] text-accent uppercase"
              data-ws-text="strings.badge"
            >
              {supportContent.strings.badge}
            </p>
            <h1
              class="mt-3 text-4xl font-black tracking-tight sm:text-5xl"
              data-ws-text="strings.heroTitle"
            >
              {supportContent.strings.heroTitle}
            </h1>
            <p
              class="mt-5 text-base leading-8 text-foreground/75 sm:text-lg"
              data-ws-text="strings.heroDescription"
            >
              {supportContent.strings.heroDescription}
            </p>

            <div class="mt-7 flex flex-wrap gap-3">
              <a
                href="mailto:i@yaho7.cn?subject=WristScore%20Support"
                class="inline-flex items-center justify-center rounded-full bg-accent px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/20"
                data-ws-text="strings.contactSupportButton"
              >
                {supportContent.strings.contactSupportButton}
              </a>
              <a
                href="/wristscore/privacy/"
                class="inline-flex items-center justify-center rounded-full border border-border bg-background px-5 py-3 text-sm font-semibold text-foreground transition hover:-translate-y-0.5 hover:border-accent/35 hover:text-accent"
                data-ws-text="strings.viewPrivacyButton"
                data-ws-preserve-lang
              >
                {supportContent.strings.viewPrivacyButton}
              </a>
            </div>
          </div>

          <div class="flex justify-center lg:justify-end">
            <div
              class="rounded-[2rem] border border-white/50 bg-white/55 p-3 shadow-[0_20px_60px_rgba(15,23,42,0.16)] backdrop-blur"
            >
              <img
                src="/apps/wristscore_icon.png"
                alt={supportContent.strings.iconAlt}
                class="h-36 w-36 rounded-[1.6rem] object-cover shadow-[0_10px_30px_rgba(15,23,42,0.14)] sm:h-44 sm:w-44"
                loading="eager"
                decoding="async"
                data-ws-attr="alt:strings.iconAlt"
              />
            </div>
          </div>
        </div>
      </section>

      <section class="mt-8 grid gap-4 lg:grid-cols-3">
        <article
          class="rounded-2xl border border-border bg-background p-6 shadow-sm lg:col-span-1"
        >
          <p
            class="text-sm font-semibold tracking-[0.16em] text-accent uppercase"
            data-ws-text="strings.contactHeading"
          >
            {supportContent.strings.contactHeading}
          </p>
          <div class="mt-4 space-y-4 text-sm text-foreground/75">
            <div>
              <div
                class="font-semibold text-foreground"
                data-ws-text="strings.supportEmailLabel"
              >
                {supportContent.strings.supportEmailLabel}
              </div>
              <a
                href="mailto:i@yaho7.cn"
                class="mt-1 inline-block text-accent hover:underline"
              >
                i@yaho7.cn
              </a>
            </div>
            <div>
              <div
                class="font-semibold text-foreground"
                data-ws-text="strings.supportedProductLabel"
              >
                {supportContent.strings.supportedProductLabel}
              </div>
              <div class="mt-1" data-ws-text="strings.supportedProductValue">
                {supportContent.strings.supportedProductValue}
              </div>
            </div>
          </div>
        </article>

        <article
          class="rounded-2xl border border-border bg-background p-6 shadow-sm lg:col-span-2"
        >
          <p
            class="text-sm font-semibold tracking-[0.16em] text-accent uppercase"
            data-ws-text="strings.checklistHeading"
          >
            {supportContent.strings.checklistHeading}
          </p>
          <div
            class="mt-4 grid gap-3 sm:grid-cols-2"
            data-ws-list="supportChecklist"
            data-ws-render="checklist-cards"
          >
            {
              supportContent.lists.supportChecklist.map(item => (
                <div class="rounded-xl border border-border/70 bg-foreground/[0.02] px-4 py-3 text-sm text-foreground/75">
                  {item}
                </div>
              ))
            }
          </div>
        </article>
      </section>

      <section class="mt-10">
        <div class="mb-4">
          <p
            class="text-sm font-semibold tracking-[0.16em] text-accent uppercase"
            data-ws-text="strings.faqSectionLabel"
          >
            {supportContent.strings.faqSectionLabel}
          </p>
          <h2 class="mt-2 text-2xl font-bold" data-ws-text="strings.faqTitle">
            {supportContent.strings.faqTitle}
          </h2>
        </div>

        <div
          class="space-y-4"
          data-ws-list="faqItems"
          data-ws-render="faq-items"
        >
          {
            supportContent.lists.faqItems.map(({ question, answer }) => (
              <article class="rounded-2xl border border-border bg-background p-6 shadow-sm">
                <h3 class="text-lg font-semibold text-foreground">
                  {question}
                </h3>
                <p class="mt-3 text-sm leading-7 text-foreground/75">
                  {answer}
                </p>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>
