---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import WristScoreLocaleSwitcher from "@/components/wristscore/WristScoreLocaleSwitcher.astro";
import { WRISTSCORE_PRIVACY_CONTENT } from "@/data/wristscoreI18n";

const privacyContent = WRISTSCORE_PRIVACY_CONTENT["zh-CN"];
const privacyMessages = {
  "zh-CN": WRISTSCORE_PRIVACY_CONTENT["zh-CN"],
  en: WRISTSCORE_PRIVACY_CONTENT.en,
};
---

<Layout
  title={privacyContent.meta.title}
  description={privacyContent.meta.description}
>
  <div data-wristscore-page>
    <Header />
    <Breadcrumb />

    <main id="main-content" class="app-layout pb-20">
      <WristScoreLocaleSwitcher
        messages={privacyMessages}
        showSelector={false}
      />

      <section
        class="relative mt-6 overflow-hidden rounded-[2rem] border border-border bg-gradient-to-br from-background via-background to-accent/[0.06] px-6 py-10 shadow-sm sm:px-10 sm:py-14"
      >
        <div
          class="absolute -top-16 right-[-2rem] h-48 w-48 rounded-full bg-accent/10 blur-3xl"
        >
        </div>
        <div
          class="absolute bottom-[-5rem] left-[-2rem] h-44 w-44 rounded-full bg-foreground/5 blur-3xl"
        >
        </div>

        <div
          class="relative grid gap-10 lg:grid-cols-[1.3fr_0.75fr] lg:items-center"
        >
          <div class="max-w-3xl">
            <p
              class="text-sm font-semibold tracking-[0.18em] text-accent uppercase"
              data-ws-text="strings.badge"
            >
              {privacyContent.strings.badge}
            </p>
            <h1
              class="mt-3 text-4xl font-black tracking-tight sm:text-5xl"
              data-ws-text="strings.heroTitle"
            >
              {privacyContent.strings.heroTitle}
            </h1>
            <p
              class="mt-4 text-sm text-foreground/55"
              data-ws-text="strings.updatedAt"
            >
              {privacyContent.strings.updatedAt}
            </p>
            <p
              class="mt-6 text-base leading-8 text-foreground/75 sm:text-lg"
              data-ws-text="strings.heroDescription"
            >
              {privacyContent.strings.heroDescription}
            </p>
          </div>

          <div class="flex justify-center lg:justify-end">
            <div
              class="rounded-[2rem] border border-white/50 bg-white/55 p-3 shadow-[0_20px_60px_rgba(15,23,42,0.16)] backdrop-blur"
            >
              <img
                src="/apps/wristscore_icon.png"
                alt={privacyContent.strings.iconAlt}
                class="h-36 w-36 rounded-[1.6rem] object-cover shadow-[0_10px_30px_rgba(15,23,42,0.14)] sm:h-44 sm:w-44"
                loading="eager"
                decoding="async"
                data-ws-attr="alt:strings.iconAlt"
              />
            </div>
          </div>
        </div>
      </section>

      <section
        class="mt-8 rounded-[1.75rem] border border-border bg-background p-6 shadow-sm sm:p-8"
      >
        <div
          class="grid gap-6 md:grid-cols-3"
          data-ws-list="summaryCards"
          data-ws-render="summary-cards"
        >
          {
            privacyContent.lists.summaryCards.map(({ title, desc }) => (
              <div class="rounded-2xl border border-border/70 bg-foreground/[0.02] p-5">
                <div class="text-sm font-semibold text-accent">{title}</div>
                <div class="mt-2 text-sm leading-7 text-foreground/75">
                  {desc}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section
        class="mt-10 space-y-4"
        data-ws-list="policySections"
        data-ws-render="policy-sections"
      >
        {
          privacyContent.lists.policySections.map(section => (
            <article class="rounded-2xl border border-border bg-background p-6 shadow-sm sm:p-7">
              <h2 class="text-xl font-bold text-foreground">{section.title}</h2>
              <p class="mt-3 text-sm leading-8 text-foreground/75 sm:text-base">
                {section.body}
              </p>
            </article>
          ))
        }
      </section>
    </main>

    <Footer />
  </div>
</Layout>
