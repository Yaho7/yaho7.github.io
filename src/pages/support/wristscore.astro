---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { SITE } from "@/config";
---

<Layout
  title={`腕上记分技术支持 | ${SITE.title}`}
  description="腕上记分技术支持页面，包含联系方式、常见问题与问题反馈说明。"
>
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout pb-20">
    <section class="relative overflow-hidden rounded-[2rem] border border-border bg-gradient-to-br from-background via-background to-accent/[0.08] px-6 py-10 shadow-sm sm:px-10 sm:py-14">
      <div class="absolute -top-16 right-[-2rem] h-48 w-48 rounded-full bg-accent/10 blur-3xl"></div>
      <div class="absolute bottom-[-5rem] left-[-2rem] h-44 w-44 rounded-full bg-foreground/5 blur-3xl"></div>

      <div class="relative grid gap-10 lg:grid-cols-[1.3fr_0.75fr] lg:items-center">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold tracking-[0.18em] text-accent uppercase">Support</p>
          <h1 class="mt-3 text-4xl font-black tracking-tight sm:text-5xl">腕上记分技术支持</h1>
          <p class="mt-5 text-base leading-8 text-foreground/75 sm:text-lg">
            如果你在使用腕上记分时遇到问题，或希望反馈建议，可以通过下面的方式联系。我们建议你在反馈时尽量提供设备信息与复现步骤，以便更快定位问题。
          </p>

          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href="mailto:i@yaho7.cn?subject=%E8%85%95%E4%B8%8A%E8%AE%B0%E5%88%86%20%E6%8A%80%E6%9C%AF%E6%94%AF%E6%8C%81"
              class="inline-flex items-center justify-center rounded-full bg-accent px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/20"
            >
              联系技术支持
            </a>
            <a
              href="/privacy/wristscore/"
              class="inline-flex items-center justify-center rounded-full border border-border bg-background px-5 py-3 text-sm font-semibold text-foreground transition hover:-translate-y-0.5 hover:border-accent/35 hover:text-accent"
            >
              查看隐私政策
            </a>
          </div>
        </div>

        <div class="flex justify-center lg:justify-end">
          <div class="rounded-[2rem] border border-white/50 bg-white/55 p-3 shadow-[0_20px_60px_rgba(15,23,42,0.16)] backdrop-blur">
            <img
              src="/apps/wristscore_icon.png"
              alt="腕上记分 App 图标"
              class="h-36 w-36 rounded-[1.6rem] object-cover shadow-[0_10px_30px_rgba(15,23,42,0.14)] sm:h-44 sm:w-44"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="mt-8 grid gap-4 lg:grid-cols-3">
      <article class="rounded-2xl border border-border bg-background p-6 shadow-sm lg:col-span-1">
        <p class="text-sm font-semibold tracking-[0.16em] text-accent uppercase">联系方式</p>
        <div class="mt-4 space-y-4 text-sm text-foreground/75">
          <div>
            <div class="font-semibold text-foreground">支持邮箱</div>
            <a href="mailto:i@yaho7.cn" class="mt-1 inline-block text-accent hover:underline">
              i@yaho7.cn
            </a>
          </div>
          <div>
            <div class="font-semibold text-foreground">适用产品</div>
            <div class="mt-1">腕上记分 / WristScore</div>
          </div>
        </div>
      </article>

      <article class="rounded-2xl border border-border bg-background p-6 shadow-sm lg:col-span-2">
        <p class="text-sm font-semibold tracking-[0.16em] text-accent uppercase">反馈时建议提供</p>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {[
            "设备型号",
            "iPhone / Apple Watch 系统版本",
            "应用版本号",
            "问题出现的具体步骤",
            "问题截图或录屏",
            "是否可稳定复现",
          ].map(item => (
            <div class="rounded-xl border border-border/70 bg-foreground/[0.02] px-4 py-3 text-sm text-foreground/75">
              {item}
            </div>
          ))}
        </div>
      </article>
    </section>

    <section class="mt-10">
      <div class="mb-4">
        <p class="text-sm font-semibold tracking-[0.16em] text-accent uppercase">常见问题</p>
        <h2 class="mt-2 text-2xl font-bold">FAQ</h2>
      </div>

      <div class="space-y-4">
        {[
          [
            "为什么手表端没有正常记录运动数据？",
            "请先确认 Apple Watch 已授予相关健康与运动权限。如果权限未开启，比赛记分仍可正常进行，但部分运动数据可能无法记录。",
          ],
          [
            "为什么历史记录或统计没有更新？",
            "请确认比赛已经正常结束并保存；如使用手表同步到手机，也请确保 iPhone 与 Apple Watch 连接正常。",
          ],
          [
            "为什么分享图内容和页面显示不一致？",
            "分享图会按当前记录或当前统计筛选条件生成，请先确认你正在查看的是目标记录或目标时间范围。",
          ],
          [
            "可以反馈新规则或新统计需求吗？",
            "可以。你可以通过邮箱提出新的比赛规则、统计项或导出样式建议，我们会按实际使用价值持续优化。",
          ],
        ].map(([question, answer]) => (
          <article class="rounded-2xl border border-border bg-background p-6 shadow-sm">
            <h3 class="text-lg font-semibold text-foreground">{question}</h3>
            <p class="mt-3 text-sm leading-7 text-foreground/75">{answer}</p>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
