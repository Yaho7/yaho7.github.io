---
// Remove current url path and remove trailing slash if exists
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, "");
const rawBreadcrumbList = currentUrlPath.split("/").slice(1);
const isWristScorePage = rawBreadcrumbList[0] === "wristscore";

// Get url array from path
// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const breadcrumbList = [...rawBreadcrumbList];

const labelMap: Record<string, string> = {
  posts: "文章",
  photos: "照片",
  about: "关于",
  archives: "归档",
  search: "搜索",
  tags: "标签",
  wristscore: "腕上记分",
};

// if breadcrumb is Home > Posts > 1 <etc>
// replace Posts with Posts (page number)
if (breadcrumbList[0] === "posts") {
  breadcrumbList.splice(0, 2, `文章（第${breadcrumbList[1] || 1}页）`);
}

// Replace top-level segments with localized labels where defined
if (labelMap[breadcrumbList[0]]) {
  breadcrumbList[0] = labelMap[breadcrumbList[0]];
}

// if breadcrumb is Home > Tags > [tag] > [page] <etc>
// replace [tag] > [page] with [tag] (page number)
if (breadcrumbList[0] === "tags" && !isNaN(Number(breadcrumbList[2]))) {
  breadcrumbList.splice(
    1,
    3,
    `${decodeURIComponent(breadcrumbList[1])}${
      Number(breadcrumbList[2]) === 1 ? "" : `（第${breadcrumbList[2]}页）`
    }`
  );
}

if (isWristScorePage) {
  if (rawBreadcrumbList[1] === "privacy") {
    breadcrumbList[1] = "隐私政策";
  } else if (rawBreadcrumbList[1] === "support") {
    breadcrumbList[1] = "技术支持";
  }
}
---

<nav class="app-layout mt-8 mb-1" aria-label="breadcrumb">
  <ul
    class="font-light [&>li]:inline [&>li:not(:last-child)>a]:hover:opacity-100"
  >
    <li>
      <a
        href="/"
        class="opacity-80"
        data-ws-text={isWristScorePage ? "strings.breadcrumbHome" : undefined}
      >
        首页
      </a>
      <span aria-hidden="true" class="opacity-80">&raquo;</span>
    </li>
    {
      breadcrumbList.map((breadcrumb, index) =>
        index + 1 === breadcrumbList.length ? (
          <li>
            <span
              class:list={["opacity-75"]}
              aria-current="page"
              data-ws-text={
                isWristScorePage
                  ? index === 0
                    ? "strings.breadcrumbRoot"
                    : "strings.breadcrumbCurrent"
                  : undefined
              }
            >
              {decodeURIComponent(breadcrumb)}
            </span>
          </li>
        ) : (
          <li>
            <a
              href={
                isWristScorePage && index === 0
                  ? "/wristscore/"
                  : `/${breadcrumb}/`
              }
              class="opacity-70"
              data-ws-text={
                isWristScorePage && index === 0
                  ? "strings.breadcrumbRoot"
                  : undefined
              }
              data-ws-preserve-lang={
                isWristScorePage && index === 0 ? true : undefined
              }
            >
              {decodeURIComponent(breadcrumb)}
            </a>
            <span aria-hidden="true">&raquo;</span>
          </li>
        )
      )
    }
  </ul>
</nav>
